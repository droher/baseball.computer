        "global_train_marginal_cross_entropy_nats": 1.05219857603972,
        "improvement_nats": 0.0655217359379412
      },
      "sql": "WITH base AS (SELECT primary_fold, FLOOR(season / 10) * 10 AS decade, COALESCE(result_family, '__unknown__') AS result_family, raw_value AS class_label FROM read_parquet('artifacts/statistical/datasets/model_input_geometry/e-v12/dataset.parquet') WHERE geometry_dimension = 'location_side' AND observed_status = 'observed' AND training_weight > 0 AND raw_value IS NOT NULL), train_cell_class AS (SELECT decade, result_family, class_label, COUNT(*) AS n FROM base WHERE primary_fold = 'TRAIN' GROUP BY ALL), train_cell AS (SELECT decade, result_family, SUM(n) AS n FROM train_cell_class GROUP BY ALL), train_global_class AS (SELECT class_label, COUNT(*) AS n FROM base WHERE primary_fold = 'TRAIN' GROUP BY 1), train_global AS (SELECT SUM(n) AS n FROM train_global_class), class_count AS (SELECT COUNT(*) AS k FROM train_global_class), scored AS (SELECT b.*, CASE WHEN tc.n IS NOT NULL THEN (COALESCE(tcc.n, 0) + 1.0) / (tc.n + cc.k) ELSE (COALESCE(tgc.n, 0) + 1.0) / (tg.n + cc.k) END AS p_conditional, (COALESCE(tgc.n, 0) + 1.0) / (tg.n + cc.k) AS p_marginal FROM base b LEFT JOIN train_cell_class tcc USING (decade, result_family, class_label) LEFT JOIN train_cell tc USING (decade, result_family) LEFT JOIN train_global_class tgc USING (class_label) CROSS JOIN train_global tg CROSS JOIN class_count cc WHERE b.primary_fold = 'TEST') SELECT COUNT(*) AS test_rows, AVG(-LN(p_conditional)) AS conditional_ce, AVG(-LN(p_marginal)) AS marginal_ce, AVG(-LN(p_marginal)) - AVG(-LN(p_conditional)) AS improvement_nats FROM scored;"
    },
